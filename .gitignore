# IDE configuration
.vs/
.idea/
.vscode/

# Local environment overrides (NEVER commit production secrets via these)
# Note: the staging .env IS committed so deployment is one-shot. For
# production (mori-capital.com), create a separate file and DO NOT commit.
.env.production
.env.local

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# PHP error logs
*.log
error_log

# Upload working dirs (keep folder, ignore contents)
uploads/documents/*
uploads/media/*
uploads/team/*
!uploads/.htaccess
!uploads/**/.gitkeep

# Composer (if added later)
vendor/
composer.lock

# Node (if any tooling added later)
node_modules/

# Editor backups
*.bak
*.swp
*~
uploads/documents/fund-updates/
uploads/documents/accounts/
uploads/documents/prospectus/
uploads/documents/policies/
