# Mori Capital — environment configuration
# Copy to .env and fill in real values. NEVER commit the real .env.

APP_ENV=production
APP_TZ=Europe/Malta
SITE_URL=https://mori-capital.com

# Database (MariaDB / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mori_capital
DB_USER=mori
DB_PASS=

# SMTP (for contact form + newsletter confirmations)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@mori-capital.com
SMTP_FROM_NAME="Mori Capital Management"
SMTP_SECURE=tls    # tls or ssl

# Uploads
UPLOAD_MAX_MB=20

# Demo mode — when true, disables sub-page navigation outside the homepage
DEMO_MODE=false
