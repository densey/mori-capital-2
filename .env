# =============================================================================
# Mori Capital — Staging environment (mori.vylence.com)
# =============================================================================
# DEPLOYMENT NOTES
#
# 1. PULL this repo into /home/mori.vylence.com/public_html/
# 2. Fill the 3 DB_* lines below with the values CyberPanel showed you
#    when you created the database (it adds a prefix like "vylence_").
# 3. chmod 640 .env          (so other users on the VPS can't read it)
# 4. Visit https://mori.vylence.com/install.php
#
# For PRODUCTION (mori-capital.com), DO NOT use this file — create a
# separate /home/mori-capital.com/public_html/.env (it's in .gitignore as
# .env.production so it won't be committed). Same keys, production values.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=production
APP_TZ=Europe/Malta
SITE_URL=https://mori.vylence.com

# --- Database (MariaDB / MySQL on CyberPanel) --------------------------------
# When you create the DB in CyberPanel, use the EXACT values below:
#   Database Name: mori_capital
#   Database User: mori_admin
#   Password:      MoriWIFo0ZoImQBX9eLT0FAGqGVj@2026
#
# Note: some CyberPanel versions add a website-prefix to DB name + user
# automatically (e.g. "<sitename>_mori_capital"). If that happens, just
# update DB_NAME and DB_USER below to match what CyberPanel actually shows
# you on the "List Databases" screen. The password stays the same.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mori_capital
DB_USER=mori_admin
DB_PASS=MoriWIFo0ZoImQBX9eLT0FAGqGVj@2026

# --- SMTP (contact form + newsletter notifications) --------------------------
# Vylence mail server, SSL/SMTPS on port 465.
# SMTP_FROM matches the authenticated user — most CyberPanel/cPanel mail
# servers reject mail when "From" doesn't match the auth identity.
SMTP_HOST=mail.vylence.com
SMTP_PORT=465
SMTP_USER=mori@vylence.com
SMTP_PASS="{cq&_QDUM[0%BV53"
SMTP_FROM=mori@vylence.com
SMTP_FROM_NAME="Mori Capital Management"
SMTP_SECURE=ssl

# --- Uploads -----------------------------------------------------------------
UPLOAD_MAX_MB=20

# --- Demo flags --------------------------------------------------------------
# DEMO_MODE=true intercepts sub-page link clicks site-wide and shows a
# "coming soon" toast. Set to false in normal operation.
DEMO_MODE=false
