# =============================================================================
# Mori Capital — Staging environment (mori.vylence.com)
# =============================================================================
# DEPLOYMENT NOTES
#
# 1. PULL this repo into /home/mori.vylence.com/public_html/
# 2. Fill the 3 DB_* lines below with the values CyberPanel showed you
#    when you created the database (it adds a prefix like "vylence_").
# 3. chmod 640 .env          (so other users on the VPS can't read it)
# 4. Visit https://mori.vylence.com/install.php
#
# For PRODUCTION (mori-capital.com), DO NOT use this file — create a
# separate /home/mori-capital.com/public_html/.env (it's in .gitignore as
# .env.production so it won't be committed). Same keys, production values.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_ENV=production
APP_TZ=Europe/Malta
SITE_URL=https://mori.vylence.com

# --- Database (MariaDB / MySQL on CyberPanel) --------------------------------
# CyberPanel typically prefixes the DB name and user (e.g. "vylence_mori").
# Use the EXACT names shown in CyberPanel → Databases → List Databases.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=REPLACE_WITH_DB_NAME
DB_USER=REPLACE_WITH_DB_USER
DB_PASS=REPLACE_WITH_DB_PASSWORD

# --- SMTP (optional — contact form + newsletter notifications) ---------------
# Leave blank for now. CyberPanel's local mail server or an external SMTP
# (SendGrid, Mailgun, Postmark, etc.) can be wired in later. The contact form
# currently saves messages to the DB (Admin → Messages) regardless.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@mori-capital.com
SMTP_FROM_NAME="Mori Capital Management"
SMTP_SECURE=tls

# --- Uploads -----------------------------------------------------------------
UPLOAD_MAX_MB=20

# --- Demo flags --------------------------------------------------------------
# DEMO_MODE=true intercepts sub-page link clicks site-wide and shows a
# "coming soon" toast. Set to false in normal operation.
DEMO_MODE=false
